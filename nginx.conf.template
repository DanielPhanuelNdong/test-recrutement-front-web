server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # SPA : toute route inconnue retombe sur index.html (React Router gère le routing client)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assets hashés par Vite : cache long, le nom change à chaque build
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
